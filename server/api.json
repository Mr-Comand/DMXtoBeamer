GET /Client/list
{
    "clients": [
        "clientID"
    ]
}
/animation/list
{
    "animationID": {
        "animationName": "animationName",
        "ParameterName": {
            "type": "bool/slider/string/textarea",
            "min": 10,
            "max": 15,
            "columns": 10,
            "rows"
        },
    }
}
POST /client/set
request
{
    "clientID": "clintid/(empty for broadcast)",
    "layers": [
        {
            "animationID": "animationID",
            "parameters": {
                "{parameterName}": "{parameterValue}",
            },
            "shader":"{shername}",
            "shaderParameters":{
                "{parameterName}": "{parameterValue}",
            },
            "textureShaderOrder":["shaderName"],
            "textureShaders":{"shaderName":{"{parameterName}": "{parameterValue}",}},
            "enabled": true,
            "dimmer": 0-255,
            "hueshift": 0-65535, //int 0 unchanged; 65535=360°
            "rotate": -32768-32767, //int 0 center; -32768 -180°; 32767 +180°
            "pan": -32768-32767, //int 0 center; -32768 -100vh; 32767 +100vh
            "tilt": -32768-32767, //int 0 center; -32768 -100vw; 32767 +100vw
            "scale": 0-255, //int 0=0x 25=1x 255=10.2x
        },
        {
            "animationID": "animationID",
            "parameters": {
                "{parameterName}": "{parameterValue}",
            },
            "shader":"{shername}",
            "shaderParameters":{
                "{parameterName}": "{parameterValue}",
            },
            "textureShaderOrder":["shaderName"],
            "textureShaders":{"shaderName":{"{parameterName}": "{parameterValue}",}},
            "enabled": true,
            "dimmer": 0-255,
            "hueshift": 0-65535, //int 0 unchanged; 65535=360°
            "rotate": -32768-32767, //int 0 center; -32768 -180°; 32767 +180°
            "pan": -32768-32767, //int 0 center; -32768 -100vh; 32767 +100vh
            "tilt": -32768-32767, //int 0 center; -32768 -100vw; 32767 +100vw
            "scale": 0-255, //int 0=0x 25=1x 255=10.2x
        },
    ],
    "dimmer": 0-255,
    "hueshift": 0-65535, //int 0 unchanged; 65535=360°
    "rotate": -32768-32767, //int 0 center; -32768 -180°; 32767 +180°
    "pan": -32768-32767, //int 0 center; -32768 -100vh; 32767 +100vh
    "tilt": -32768-32767, //int 0 center; -32768 -100vw; 32767 +100vw
    "scale": 0-255, //int 0=0x 25=1x 255=10.2x
}
response: {
    "success": "message",
    "error": "message"
}


