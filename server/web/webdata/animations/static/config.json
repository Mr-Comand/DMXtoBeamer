{
    "animationName": "static Shape",
    "parameters": {
        "Color": {
            "type": "color",
            "default": "#ff0000",
            "stepSize": 1
        },
        "Shape": {
            "type": "enum",
            "enumElements": [
                "Circle",
                "Square",
                "Rectangle",
                "Triangle",
                "Snowflake"
            ]
        },
        "Hollow": {
            "type": "bool",
            "default": false
        },
        "Rotation": {
            "type": "number",
            "min": 0,
            "max": 360,
            "default": 0,
            "stepSize": 1
        },
        "LineWidth": {
            "type": "number",
            "min": 1,
            "max": 100,
            "default": 50,
            "stepSize": 1
        },
        "Size": {
            "type": "number",
            "min": 1,
            "max": 100,
            "default": 50,
            "stepSize": 1
        }
       
    }
}

